# Copie para apps/server/.env e ajuste se precisar.
# Sem este arquivo o servidor roda igual, mas o progresso só vive em memória:
# reiniciar o servidor zera todo mundo.
DATABASE_URL=postgres://islabr:islabr@localhost:5432/islabr

# Itens dados a todo jogador que entra, para testar combate sem cumprir a m01.
# Ids de items.json separados por vírgula. Deixe vazio num servidor de verdade.
# graveto_reforcado = arma inicial (1 de dano); arma_nv2 = Espada de Coral (2 de dano).
ISLABR_KIT_DE_TESTE=
